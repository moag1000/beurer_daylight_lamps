{
  "entity": {
    "button": {
      "identify": {
        "default": "mdi:flashlight"
      },
      "reconnect": {
        "default": "mdi:bluetooth-connect"
      },
      "sync_time": {
        "default": "mdi:clock-sync"
      }
    },
    "sensor": {
      "rssi": {
        "default": "mdi:signal"
      },
      "therapy_today": {
        "default": "mdi:sun-clock"
      },
      "therapy_week": {
        "default": "mdi:calendar-week"
      },
      "therapy_progress": {
        "default": "mdi:progress-check"
      },
      "last_notification": {
        "default": "mdi:bluetooth-transfer"
      },
      "last_time_sync": {
        "default": "mdi:clock-check-outline"
      },
      "reconnect_count": {
        "default": "mdi:connection"
      },
      "command_success_rate": {
        "default": "mdi:check-network"
      },
      "connection_uptime": {
        "default": "mdi:timer-outline"
      }
    },
    "binary_sensor": {
      "connected": {
        "default": "mdi:bluetooth-connect",
        "state": {
          "on": "mdi:bluetooth-connect",
          "off": "mdi:bluetooth-off"
        }
      },
      "ble_available": {
        "default": "mdi:bluetooth-audio",
        "state": {
          "on": "mdi:bluetooth",
          "off": "mdi:bluetooth-off"
        }
      },
      "therapy_goal_reached": {
        "default": "mdi:check-circle-outline",
        "state": {
          "on": "mdi:check-circle",
          "off": "mdi:circle-outline"
        }
      }
    },
    "select": {
      "effect": {
        "default": "mdi:palette"
      },
      "therapy_user": {
        "default": "mdi:account"
      }
    },
    "number": {
      "white_brightness": {
        "default": "mdi:brightness-6"
      },
      "color_brightness": {
        "default": "mdi:brightness-7"
      },
      "timer": {
        "default": "mdi:timer-outline"
      },
      "therapy_goal": {
        "default": "mdi:target"
      },
      "radio_volume": {
        "default": "mdi:volume-medium"
      },
      "music_volume": {
        "default": "mdi:speaker"
      }
    },
    "switch": {
      "adaptive_lighting": {
        "default": "mdi:brightness-auto",
        "state": {
          "on": "mdi:brightness-auto",
          "off": "mdi:brightness-5"
        }
      },
      "feedback_sound": {
        "default": "mdi:volume-high"
      },
      "fade": {
        "default": "mdi:transition-masked"
      },
      "alarm_1": {
        "default": "mdi:alarm",
        "state": {
          "on": "mdi:alarm",
          "off": "mdi:alarm-off"
        }
      },
      "alarm_2": {
        "default": "mdi:alarm",
        "state": {
          "on": "mdi:alarm",
          "off": "mdi:alarm-off"
        }
      },
      "alarm_3": {
        "default": "mdi:alarm",
        "state": {
          "on": "mdi:alarm",
          "off": "mdi:alarm-off"
        }
      }
    },
    "event": {
      "lamp_event": {
        "default": "mdi:bell-ring-outline",
        "state_attributes": {
          "event_type": {
            "state": {
              "timer_finished": "mdi:timer-check-outline",
              "timer_cancelled": "mdi:timer-cancel-outline",
              "sleep_timer_finished": "mdi:sleep",
              "sunrise_finished": "mdi:weather-sunset-up",
              "sunset_finished": "mdi:weather-sunset-down"
            }
          }
        }
      }
    },
    "time": {
      "alarm_1_time": {
        "default": "mdi:alarm"
      },
      "alarm_2_time": {
        "default": "mdi:alarm"
      },
      "alarm_3_time": {
        "default": "mdi:alarm"
      }
    }
  },
  "services": {
    "apply_preset": "mdi:palette-swatch",
    "set_timer": "mdi:timer",
    "send_raw_command": "mdi:console",
    "start_sunrise": "mdi:weather-sunset-up",
    "start_sunset": "mdi:weather-sunset-down",
    "stop_simulation": "mdi:stop",
    "set_alarm": "mdi:alarm",
    "sync_time": "mdi:clock-sync",
    "set_therapy_user": "mdi:account"
  },
  "triggers": {
    "timer_finished": {
      "trigger": "mdi:timer-check-outline"
    },
    "timer_cancelled": {
      "trigger": "mdi:timer-cancel-outline"
    },
    "sleep_timer_finished": {
      "trigger": "mdi:sleep"
    },
    "sunrise_finished": {
      "trigger": "mdi:weather-sunset-up"
    },
    "sunset_finished": {
      "trigger": "mdi:weather-sunset-down"
    },
    "therapy_goal_reached": {
      "trigger": "mdi:trophy-outline"
    }
  },
  "conditions": {
    "is_therapy_goal_reached": {
      "condition": "mdi:trophy-outline"
    },
    "is_connected": {
      "condition": "mdi:bluetooth-connect"
    }
  }
}
